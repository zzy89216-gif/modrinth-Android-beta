<?xml version="1.0" encoding="utf-8"?>
<!--
  Modrinth 官方风格标志（第三方客户端使用，品牌归属 Modrinth）：
  绿色分段圆环（4 个对角缺口）+ 中央扳手（倾斜 30°）。
  官方品牌色 #00AF5E。108dp 视口，内容落在中央安全区。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 圆环：4 段弧，半径 26，环宽 7，缺口在 45°/135°/225°/315° 对角线 -->
    <path
        android:pathData="M 65.8 30.8 A 26 26 0 0 0 42.2 30.8"
        android:strokeColor="#00AF5E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 30.8 42.2 A 26 26 0 0 0 30.8 65.8"
        android:strokeColor="#00AF5E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 42.2 77.2 A 26 26 0 0 0 65.8 77.2"
        android:strokeColor="#00AF5E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 77.2 65.8 A 26 26 0 0 0 77.2 42.2"
        android:strokeColor="#00AF5E"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 扳手（垂直绘制后整体旋转 30°，开口朝上偏右） -->
    <group
        android:name="wrench"
        android:rotation="30"
        android:pivotX="54"
        android:pivotY="54">
        <!-- 头部：圆环 + 顶部开口（U 形夹口） -->
        <path
            android:pathData="M 49 34.2 A 11 11 0 1 0 59 34.2 L 59 44 L 49 44 Z"
            android:fillColor="#00AF5E" />
        <!-- 手柄：向下延伸，底部圆角 -->
        <path
            android:pathData="M 50 44 L 50 68 Q 50 72 54 72 Q 58 72 58 68 L 58 44 Z"
            android:fillColor="#00AF5E" />
    </group>
</vector>
